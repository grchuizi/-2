# 示例文件：只保留变量名，严禁填写真实 Key 后提交。
# 真实密钥只允许存在于本机临时环境变量或 GitHub Actions Secrets。

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

SEARCH_API_KEY=

# 注意：SERVERCHAN_KEY 是推送/通知正用名（config system.yaml notification.serverchan_key_env）。
# 勿用旧名 SERVERCHAN_SENDKEY，否则推送会因空 key 静默失败。
SERVERCHAN_KEY=

LOG_LEVEL=
